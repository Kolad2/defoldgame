# C++ symbol in your extension
name: "detour"
platforms:
    common:
        context:
            symbols: ["NavMeshPreviewResource", "NavMeshPreviewComponent"]
            libs: ["detour_runtime", "recast"]
# All C++ implementation is precompiled by CMake. The empty src/extension.cpp
# needs no Recast headers; their include directories are defined in CMakeLists.txt.
