# Runtime integration is compiled against the engine revision used by Defold.
# Only the small official headers archive is required to create a static library.
set(defold_default "$ENV{DEFOLD_HOME}")
if(NOT defold_default)
    set(defold_default "${CMAKE_CURRENT_SOURCE_DIR}/../../../Defold")
endif()
set(DETOUR_DEFOLD_DIR "${defold_default}" CACHE PATH "Installed Defold directory (config and packages)")
set(DETOUR_DEFOLD_SDK_SHA "" CACHE STRING "Override engine SHA for the native SDK; empty uses installed Defold")
set(DETOUR_DEFOLD_SDK_ROOT "" CACHE PATH "Existing extracted defoldsdk root; empty downloads matching headers")
set(detour_sdk_sha "${DETOUR_DEFOLD_SDK_SHA}")
if(NOT detour_sdk_sha)
    if(NOT EXISTS "${DETOUR_DEFOLD_DIR}/config")
        message(FATAL_ERROR "Set DETOUR_DEFOLD_DIR to your installed Defold, or set DETOUR_DEFOLD_SDK_SHA explicitly.")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${DETOUR_DEFOLD_DIR}/config")
    file(READ "${DETOUR_DEFOLD_DIR}/config" sdk_defold_config)
    string(REGEX MATCH "engine_sha1[ \t]*=[ \t]*([a-fA-F0-9]+)" unused "${sdk_defold_config}")
    set(detour_sdk_sha "${CMAKE_MATCH_1}")
endif()
string(LENGTH "${detour_sdk_sha}" sdk_sha_length)
if(NOT sdk_sha_length EQUAL 40 OR NOT detour_sdk_sha MATCHES "^[a-fA-F0-9]+$")
    message(FATAL_ERROR "The Defold SDK engine SHA must contain 40 hexadecimal characters.")
endif()

set(sdk_root "${DETOUR_DEFOLD_SDK_ROOT}")
if(NOT sdk_root)
    set(sdk_cache "${DETOUR_BUILD_CACHE_DIR}/defold-sdk/${detour_sdk_sha}")
    set(sdk_root "${sdk_cache}/defoldsdk")
    if(NOT EXISTS "${sdk_root}/sdk/include/dmsdk/sdk.h")
        file(MAKE_DIRECTORY "${sdk_cache}")
        set(sdk_archive "${sdk_cache}/defoldsdk_headers.zip")
        if(NOT EXISTS "${sdk_archive}")
            message(STATUS "Downloading official Defold SDK headers: ${detour_sdk_sha}")
            file(DOWNLOAD
                "https://d.defold.com/archive/${detour_sdk_sha}/engine/defoldsdk_headers.zip"
                "${sdk_archive}.part" TLS_VERIFY ON STATUS sdk_download_status)
            list(GET sdk_download_status 0 sdk_download_code)
            if(NOT sdk_download_code EQUAL 0)
                message(FATAL_ERROR "SDK download failed: ${sdk_download_status}. For offline builds set DETOUR_DEFOLD_SDK_ROOT to the matching extracted defoldsdk directory.")
            endif()
            file(RENAME "${sdk_archive}.part" "${sdk_archive}")
        endif()
        if(detour_sdk_sha STREQUAL "ee283d4dad9fa451dd6399d83602e1dc25133681")
            file(SHA256 "${sdk_archive}" sdk_archive_hash)
            if(NOT sdk_archive_hash STREQUAL "8009b1ba37626949c090834098e9e30b958b15a3bb0f0eaf9c8c4f6b6654c1b4")
                message(FATAL_ERROR "Unexpected Defold 1.14.1 SDK headers checksum: ${sdk_archive}")
            endif()
        endif()
        file(ARCHIVE_EXTRACT INPUT "${sdk_archive}" DESTINATION "${sdk_cache}")
    endif()
endif()
if(NOT EXISTS "${sdk_root}/sdk/include/dmsdk/sdk.h")
    message(FATAL_ERROR "DETOUR_DEFOLD_SDK_ROOT must contain sdk/include/dmsdk/sdk.h: ${sdk_root}")
endif()
set(DETOUR_SDK_INCLUDE_DIRS "${sdk_root}/sdk/include" "${sdk_root}/include" "${sdk_root}/ext/include")
message(STATUS "Runtime Defold SDK: ${detour_sdk_sha} (${sdk_root})")
