foreach(required EDITOR_BUILD_DIR PROJECT_BINARY_DIR EDITOR_SOURCE_DIR EDITOR_JAVA EDITOR_JAR_TOOL EDITOR_API EDITOR_ECJ)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
cmake_path(ABSOLUTE_PATH PROJECT_BINARY_DIR NORMALIZE OUTPUT_VARIABLE binary_root)
cmake_path(ABSOLUTE_PATH EDITOR_BUILD_DIR NORMALIZE OUTPUT_VARIABLE build_dir)
cmake_path(IS_PREFIX binary_root "${build_dir}" NORMALIZE inside_build)
if(NOT inside_build OR build_dir STREQUAL binary_root)
    message(FATAL_ERROR "Editor classes must be built in a subdirectory of the CMake binary directory.")
endif()
set(classes "${build_dir}/classes")
# Only this target's generated classes are removed, after checking their parent.
file(REMOVE_RECURSE "${classes}")
file(MAKE_DIRECTORY "${classes}")
file(GLOB_RECURSE java_sources "${EDITOR_SOURCE_DIR}/*.java")
execute_process(COMMAND "${EDITOR_JAVA}" -jar "${EDITOR_ECJ}" -21 -proc:none -warn:none
    -cp "${EDITOR_API}" -d "${classes}" ${java_sources} RESULT_VARIABLE compile_result)
if(NOT compile_result EQUAL 0)
    message(FATAL_ERROR "Editor Java compilation failed (${compile_result}).")
endif()
execute_process(COMMAND "${EDITOR_JAR_TOOL}" --create --file "${build_dir}/navmesh-editor.jar"
    -C "${classes}" com RESULT_VARIABLE jar_result)
if(NOT jar_result EQUAL 0)
    message(FATAL_ERROR "Editor JAR packaging failed (${jar_result}).")
endif()
