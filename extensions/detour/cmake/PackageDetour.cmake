foreach(required RECAST_ROOT RECAST_ARCHIVE RUNTIME_ARCHIVE DETOUR_SDK_SHA DETOUR_EXTENSION_DIR DETOUR_PLATFORM)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
foreach(archive IN ITEMS "${RECAST_ARCHIVE}" "${RUNTIME_ARCHIVE}")
    if(NOT EXISTS "${archive}")
        message(FATAL_ERROR "Library has not been built: ${archive}")
    endif()
endforeach()
if(DETOUR_PLATFORM STREQUAL "x86_64-win32")
    if(NOT EXISTS "${DETOUR_DUMPBIN}")
        message(FATAL_ERROR "Windows packaging requires DETOUR_DUMPBIN to verify the compiled CRT ABI.")
    endif()
    foreach(archive IN ITEMS "${RECAST_ARCHIVE}" "${RUNTIME_ARCHIVE}")
        execute_process(COMMAND "${DETOUR_DUMPBIN}" /directives "${archive}"
            RESULT_VARIABLE crt_result OUTPUT_VARIABLE crt_directives ERROR_VARIABLE crt_error)
        if(NOT crt_result EQUAL 0)
            message(FATAL_ERROR "Cannot inspect ${archive}: ${crt_error}")
        endif()
        string(TOUPPER "${crt_directives}" crt_directives)
        if(crt_directives MATCHES "RUNTIMELIBRARY=(MD_|MT_STATICDEBUG)" OR
           crt_directives MATCHES "DEFAULTLIB:[\"]?(MSVCRT|LIBCMTD)" OR
           NOT crt_directives MATCHES "DEFAULTLIB:[\"]?LIBCMT")
            message(FATAL_ERROR "${archive} must use /MT (static release CRT) to match Defold. Rebuild all targets with MSVC_RUNTIME_LIBRARY=MultiThreaded.")
        endif()
    endforeach()
    message(STATUS "Both game archives match Defold's static release CRT (/MT).")
endif()
if(DEFINED EDITOR_DLL OR DEFINED EDITOR_JAR)
    if(NOT EXISTS "${EDITOR_DLL}" OR NOT EXISTS "${EDITOR_JAR}")
        message(FATAL_ERROR "Both editor DLL and JAR must be built before packaging.")
    endif()
endif()

set(lib_dir "${DETOUR_EXTENSION_DIR}/lib/${DETOUR_PLATFORM}")
set(include_dir "${DETOUR_EXTENSION_DIR}/include")
file(MAKE_DIRECTORY "${lib_dir}" "${include_dir}")
foreach(archive IN ITEMS "${RECAST_ARCHIVE}" "${RUNTIME_ARCHIVE}")
    cmake_path(GET archive FILENAME archive_name)
    file(COPY_FILE "${archive}" "${lib_dir}/${archive_name}" ONLY_IF_DIFFERENT)
    message(STATUS "Ready for Defold: ${lib_dir}/${archive_name}")
endforeach()
set(sdk_stamp "Defold engine SDK: ${DETOUR_SDK_SHA}\nRebuild detour_runtime when upgrading Defold.\n")
set(sdk_stamp_path "${lib_dir}/defold-sdk.txt")
set(previous_sdk_stamp "")
if(EXISTS "${sdk_stamp_path}")
    file(READ "${sdk_stamp_path}" previous_sdk_stamp)
endif()
if(NOT previous_sdk_stamp STREQUAL sdk_stamp)
    file(WRITE "${sdk_stamp_path}" "${sdk_stamp}")
endif()

foreach(module Recast Detour DetourCrowd DetourTileCache DebugUtils)
    file(GLOB headers "${RECAST_ROOT}/${module}/Include/*.h")
    foreach(header IN LISTS headers)
        cmake_path(GET header FILENAME header_name)
        file(COPY_FILE "${header}" "${include_dir}/${header_name}" ONLY_IF_DIFFERENT)
    endforeach()
endforeach()
file(COPY_FILE "${RECAST_ROOT}/License.txt" "${include_dir}/recastnavigation-license.txt" ONLY_IF_DIFFERENT)
if(DEFINED EDITOR_DLL)
    set(editor_lib_dir "${DETOUR_EXTENSION_DIR}/plugins/lib/x86_64-win32")
    set(editor_jar_dir "${DETOUR_EXTENSION_DIR}/plugins/share")
    file(MAKE_DIRECTORY "${editor_lib_dir}" "${editor_jar_dir}")
    file(COPY_FILE "${EDITOR_DLL}" "${editor_lib_dir}/navmesh_editor.dll" ONLY_IF_DIFFERENT)
    file(COPY_FILE "${EDITOR_JAR}" "${editor_jar_dir}/navmesh-editor.jar" ONLY_IF_DIFFERENT)
    message(STATUS "Editor DLL/JAR ready; restart Defold after replacing a loaded plugin.")
endif()
