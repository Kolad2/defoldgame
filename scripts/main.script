local Game = require("scripts.game.game")
local Location = require("scripts.location.location")

function init(self)
    Game:init()
    local scene_data, scene_error = sys.load_resource("/assets/locations/bar/bar.json")
    assert(scene_data, scene_error)
    local scene = json.decode(scene_data)
    self.location = Location:create(go.get_id("/location"), scene)
    -- The doorway plane marks an interaction area and should not be rendered.
    self.location:set_node_visible("area", false)

    -- Calculate initial visibility once; update explicitly when the camera changes.
    local component = msg.url(Game.camera.camera_url)
    local camera_go = msg.url(component.socket, component.path, nil)
    go.update_world_transform(camera_go)
    local rotation = go.get_world_rotation(camera_go)
    local direction = vmath.rotate(rotation, vmath.vector3(0, 0, -1))
    self.location:update_visibility(direction)
end

function update(self, dt)
    Game:update(dt)
end

function on_input(self, action_id, action)
    Game:on_input(action_id, action)
end
