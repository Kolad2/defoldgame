local iso = require "scripts.isometric"
local WALK = "Mixamo | Catwalk Walk Forward"
local directions = {
    [hash("left")] = {-1, 0}, [hash("right")] = {1, 0},
    [hash("up")] = {0, 1}, [hash("down")] = {0, -1}
}

local function set_walking(self, moving)
    if self.moving == moving then return end
    self.moving = moving
    go.set("#model", "playback_rate", moving and 1 or 0)
    if not moving then go.set("#model", "cursor", 0) end
end

function init(self)
    self.keys = {}
    self.moving = false
    self.target = nil
    msg.post(".", "acquire_input_focus")
    -- The collection and the game use the same scene coordinates and model pose.
    model.play_anim("#model", WALK, go.PLAYBACK_LOOP_FORWARD, {playback_rate=0})
    print("ISOMETRIC_READY: arrows / click to move")
end

function update(self, dt)
    local sx, sy = 0, 0
    for key in pairs(self.keys) do
        local d = directions[key]
        sx, sy = sx+d[1], sy+d[2]
    end
    local scene_pos = go.get_position()
    -- Measure movement on the ground plane, then project back into the scene.
    local pos = iso.to_world(scene_pos.x, scene_pos.y)
    local delta
    if sx ~= 0 or sy ~= 0 then
        self.target = nil
        delta = iso.to_world(iso.width/2+sx, iso.height/2+sy)
    elseif self.target then
        delta = self.target-pos
    end
    if delta and vmath.length_sqr(delta) > 0.000001 then
        local distance = vmath.length(delta)
        local direction = delta/distance
        local step = iso.speed*math.min(dt, 0.1)
        if self.target then step = math.min(step, distance) end
        local next_pos = iso.clamp_to_map(pos+direction*step)
        local moved = vmath.length_sqr(next_pos-pos) > 0.0000001
        local image_x, image_y = iso.to_image(next_pos)
        go.set_position(vmath.vector3(image_x, image_y, scene_pos.z))
        if moved then
            go.set_rotation(iso.scene_rotation(math.atan2(-direction.x, -direction.z)))
        end
        set_walking(self, moved)
        if self.target and distance <= step+0.001 then
            self.target = nil
            set_walking(self, false)
            local x,y = iso.to_image(next_pos)
            print("ISOMETRIC_ARRIVED", math.floor(x), math.floor(y))
        end
    else
        set_walking(self, false)
    end
end

function on_input(self, action_id, action)
    if directions[action_id] then
        if action.pressed then self.keys[action_id] = true end
        if action.released then self.keys[action_id] = nil end
        return true
    end
    if action_id == hash("touch") and action.pressed then
        -- screen_x/y and window.get_size() both use physical window pixels.
        local w,h = window.get_size()
        local vx,vy,vw,vh = iso.viewport(w,h)
        local px,py = action.screen_x, action.screen_y
        if px and py and px>=vx and px<=vx+vw and py>=vy and py<=vy+vh then
            self.target=iso.clamp_to_map(iso.to_world((px-vx)*iso.width/vw, (py-vy)*iso.height/vh))
        end
        -- Let game.script receive this press as well.
    end
end
